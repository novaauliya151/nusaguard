APP_ENV=development
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
EXPOSE_RESET_TOKEN=false
NUSAGUARD_MODEL_REPO=your-huggingface-username/nusaguard-indobert
